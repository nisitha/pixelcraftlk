# ----------------------------------------------------------------------
# PixelCraft Studios — Apache / cPanel Configuration (.htaccess)
# Target Domain: https://pixelcraftlk.com
# ----------------------------------------------------------------------

RewriteEngine On
RewriteBase /

# 1. Enforce HTTPS & Canonical Domain (Redirect www to non-www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.pixelcraftlk\.com$ [NC]
RewriteRule ^(.*)$ https://pixelcraftlk.com/$1 [L,R=301]

# 2. Disable directory browsing for security
Options -Indexes

# 3. Handle Clean URLs & Subfolder Routing
# If the requested path exists as a physical file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# If the request matches a folder with an index.html, serve that folder's index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/?$ $1/index.html [L]

# Clean URL fallback: map /page to /page.html if it exists
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# 4. Custom 404 Error Document
ErrorDocument 404 /404/index.html

# 5. Production Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 6. Gzip / Deflate Compression for High Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 7. Browser Asset Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
