# ==============================================================================
# PixelCraft Studios — Production Environment Configuration (.env.example)
# Target Domain: https://pixelcraftlk.com
# ==============================================================================

# 1. Base Canonical URL
NEXT_PUBLIC_SITE_URL="https://pixelcraftlk.com"

# 2. Resend Email Dispatch (Required for Contact Form delivery)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=""

# Recipient Email Address for Inbound Client Inquiries
CONTACT_RECIPIENT_EMAIL="pixelcraftstudioslk@gmail.com"

# 3. Stripe Commerce & Retainers (Optional - for live credit card checkout)
# Obtain from https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# 4. Web Analytics (Optional - configure when privacy consent policy is active)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# 5. Namecheap cPanel Automated FTP / FTPS Deployment
# Configured for automated static synchronization via `npm run deploy`
FTP_HOST="ftp.pixelcraftlk.com"
FTP_USER="deploy@pixelcraftlk.com"
FTP_PASSWORD="your-strong-ftp-password"
FTP_REMOTE_ROOT="/public_html"
FTP_PORT="21"
FTP_SECURE="true"
# FTP_REJECT_UNAUTHORIZED="false"
# FTP_VERBOSE="false"
